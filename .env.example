# Copy this file to .env and fill in the values. Never commit .env.

# ElevenLabs API key (Settings, API keys). Sent as the xi-api-key header.
# Needed for --apply, --teardown and the evals commands. Not needed for a dry run.
ELEVENLABS_API_KEY=

# Shared secret your webhook tool server checks. setup_agent stores it at
# ElevenLabs as a workspace secret holding the full header value
# "Bearer <this value>", so the server receives "Authorization: Bearer <this value>".
# The variable name must match "secret_env" in your brand file.
VOICE_TOOL_SECRET=
